  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "let arrayData = [",
          "    '|',",
          "    request.method, ",
          "    request.url.replace('{{URI_BASE}}','').replace('{{USER_ID}}', pm.variables.get('USER_ID')),",
          "    (pm.request.headers.has('Authorization') ? pm.variables.get('ACCESS_TOKEN') ?? '' : '').replace('Bearer ', ''), ",
          "   pm.request.body.raw ? Buffer.from(pm.request.body.raw ?? '').toString('Base64'):'',",
          "   '|'",
          "];",
          "//console.log(JSON.stringify(JSON.parse(pm.request.body.raw ?? '')),Buffer.from(JSON.stringify(JSON.parse(pm.request.body.raw ?? ''))).toString('Base64'));",
          "let stringData = arrayData.join('|');",
          "console.log(stringData, CryptoJS.SHA256(pm.variables.get(\"HMAC_KEY\")).toString());",
          "let signature = CryptoJS.HmacSHA256(",
          "        stringData, ",
          "        CryptoJS.SHA256(pm.variables.get(\"HMAC_KEY\")).toString()",
          ").toString(CryptoJS.enc.Base64);",
          "pm.variables.set(",
          "    \"HMAC_SIGNATURE\", ",
          "    signature",
          ");"
        ],
        "id": "d92021e1-0acb-4ab2-bbb6-49494a22942c"
      }
